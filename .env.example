# =============================================================================
# Obsidian Wiki — Environment Configuration
# Copy this to .env and set your vault path
# =============================================================================

# --- Required ---

# Absolute path to your Obsidian vault
OBSIDIAN_VAULT_PATH=

# --- Optional ---

# Comma-separated source directories to ingest documents from
# Leave empty to skip document ingestion
OBSIDIAN_SOURCES_DIR=

# Wiki categories (directories created in the vault)
OBSIDIAN_CATEGORIES=concepts,entities,skills,references,synthesis,journal

# Max pages to create/update per ingest operation
OBSIDIAN_MAX_PAGES_PER_INGEST=15

# Claude conversation history path (auto-discovered from ~/.claude if empty)
CLAUDE_HISTORY_PATH=

# Codex history path (defaults to ~/.codex if empty)
CODEX_HISTORY_PATH=

# Lint schedule: daily | weekly | manual
LINT_SCHEDULE=weekly

# --- ClickHouse RAG (recommended semantic-search tier) ---
#
# Primary semantic search and dedup layer. `wiki-rag-index` populates a ClickHouse table with
# chunked + embedded wiki pages and raw sources. `wiki-query` and `wiki-ingest` hit it via HTTP.
#
# Retrieval order when configured: ClickHouse RAG → QMD (if set) → Grep/Glob.
# Without CLICKHOUSE_URL, skills skip to the next tier transparently.

# ClickHouse HTTP URL — any reachable instance (local Docker, hosted, ClickHouse Cloud).
# Leave empty to disable the ClickHouse RAG tier entirely.
CLICKHOUSE_URL=

# Database to create/use for RAG tables. `wiki-rag-index` creates it if missing.
CLICKHOUSE_DATABASE=obsidian_rag

# Optional auth (leave empty for unauthenticated local instances).
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Logical collection names written into the rag_chunks.collection column.
RAG_WIKI_COLLECTION=wiki
RAG_PAPERS_COLLECTION=papers

# Embedding provider: openai | ollama | lmstudio
# - openai: production-quality, API key required, default text-embedding-3-small (1536 dims)
# - ollama: local, free, default bge-m3 (1024 dims), needs `ollama pull bge-m3`
# - lmstudio: local, OpenAI-compatible endpoint, default bge-m3 (1024 dims)
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMS=1536

# Provider endpoints (only used by the matching provider).
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=http://localhost:1234/v1

# --- QMD Semantic Search (optional, legacy fallback tier) ---
#
# QMD is a local MCP server that indexes your wiki and sources for fast semantic search.
# Install: https://github.com/tobi/qmd
# After installing, point these at your QMD collection names (set when you ran `qmd index`).
#
# Kept as a fallback below ClickHouse RAG for setups that haven't migrated. Safe to leave empty.
# Without ClickHouse or QMD, skills fall back to Grep/Glob — fully functional, just slower.

# Name of the QMD collection indexing your compiled wiki pages (OBSIDIAN_VAULT_PATH)
QMD_WIKI_COLLECTION=

# Name of the QMD collection indexing your raw source documents (OBSIDIAN_SOURCES_DIR or _raw/)
QMD_PAPERS_COLLECTION=

# --- Raw Staging Directory (optional) ---
#
# A directory inside OBSIDIAN_VAULT_PATH for unprocessed draft pages.
# Drop rough notes, clipboard pastes, or quick captures here.
# wiki-ingest will promote them to proper wiki pages when you run it.
# Promoted files are deleted from _raw/ after processing.
OBSIDIAN_RAW_DIR=_raw
